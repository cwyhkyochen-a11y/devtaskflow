# 复制本文件为 .env 或按你的运行方式导出环境变量。
# 在 Codex 中通过 $devtaskflow 使用时，通常不需要配置这些 LLM 变量。
# 只有独立 CLI / local_llm / OpenAI-compatible 编排模式才需要填写。
DTFLOW_LLM_BASE_URL=https://your-llm-endpoint.example.com/v1
DTFLOW_LLM_API_KEY=your_api_key_here
DTFLOW_LLM_MODEL=your_model_name_here

# 可选项：只有你真的需要部署/归档或独立 Codex 编排模型时再配置。
DTFLOW_DEPLOY_TARGET=
DTFLOW_ARCHIVE_TARGET=
DTFLOW_CODEX_BASE_URL=
DTFLOW_CODEX_API_KEY=
DTFLOW_CODEX_MODEL=
